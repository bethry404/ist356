{
  "name": "IST356",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [18888, 18501, 18000],
  "portsAttributes": {
    "8888": { "label": "Jupyter" },
    "8501": { "label": "Streamlit" },
    "8000": { "label": "FastAPI" }
  },
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}